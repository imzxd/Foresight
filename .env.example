# Copy to .env.local. Without the three Supabase values the app runs in read-only Demo Mode.

# --- Supabase (required for live mode) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI extraction (OpenAI Responses API) ---
OPENAI_API_KEY=
# Economical model with structured-output support; change freely.
OPENAI_EXTRACTION_MODEL=gpt-5-mini

# --- Inbound email (Resend) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Domain whose MX records point at Resend inbound, e.g. in.yourdomain.com
INBOUND_EMAIL_DOMAIN=

# --- Background jobs (Inngest). Leave empty locally to process uploads inline. ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Limits (optional) ---
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=20

# Test-only: "mock" swaps AI extraction for a deterministic parser. Never set in production.
# EXTRACTOR_MODE=
